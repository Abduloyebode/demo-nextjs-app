# App
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# PostgreSQL (local docker-compose default)
DATABASE_URL=postgresql://northstar:northstar@localhost:5432/northstar

# OpenAI (Step 3: document extraction). Never commit a real key.
# Model used: gpt-5-mini. Each document is capped at 15,000 characters of
# input text, so cost per document is roughly $0.001 input + $0.001 output
# = ~$0.002 (about 1/5 of a cent). 1,000 documents processed costs roughly $2.
OPENAI_API_KEY=replace-with-your-openai-api-key
